#!/bin/sh
# Pre-push hook: lint, test, and secret scan
set -e

echo "🔍 Running pre-push checks..."

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

PASS=true

# 1. Ruff lint
echo ""
echo "📐 [1/3] Ruff lint..."
if ruff check app/ tests/; then
    echo "${GREEN}   Lint OK${NC}"
else
    echo "${RED}   Lint FAILED${NC}"
    PASS=false
fi

# 2. Pytest (quick mode)
echo ""
echo "🧪 [2/3] Running tests (no coverage)..."
if python -m pytest tests/ -q --tb=short -x; then
    echo "${GREEN}   Tests OK${NC}"
else
    echo "${RED}   Tests FAILED${NC}"
    PASS=false
fi

# 3. Secret scan - detect hardcoded keys
echo ""
echo "🔑 [3/3] Scanning for secrets..."
SECRET_PATTERNS="(sk-[a-zA-Z0-9]{20,}|api[-_]?key|secret[-_]?key|password|token)"
VIOLATIONS=$(git diff --cached --name-only 2>/dev/null | xargs -I{} grep -nliE "$SECRET_PATTERNS" {} 2>/dev/null || true)
CACHED_VIOLATIONS=$(git diff --cached --name-only 2>/dev/null | grep -v '.env.example' | xargs -I{} grep -nliE "$SECRET_PATTERNS" {} 2>/dev/null || true)

if [ -n "$CACHED_VIOLATIONS" ]; then
    echo "${RED}   ⚠️  Possible secrets detected in staged files:${NC}"
    echo "$CACHED_VIOLATIONS" | while read -r line; do
        echo "      - $line"
    done
    echo "${YELLOW}   Remove before pushing or use --no-verify to skip${NC}"
    PASS=false
else
    echo "${GREEN}   No secrets detected${NC}"
fi

echo ""
if [ "$PASS" = true ]; then
    echo "${GREEN}✅ All checks passed, pushing...${NC}"
    exit 0
else
    echo "${RED}❌ Pre-push checks failed. Fix errors above or use --no-verify to skip.${NC}"
    exit 1
fi
